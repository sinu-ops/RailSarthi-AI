# RailSarthi AI Environment Configuration Template
# Copy this file to .env and add your actual API keys
# DO NOT commit .env to git

# Railway API Configuration (RailRadar v1)
RAILWAY_API_KEY=your_railradar_api_key_here
RAILWAY_API_BASE_URL=https://api.railradar.in/v1

# LLM Configuration (Gemini API for Week 3)
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./railsarthi.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Cache Configuration
CACHE_TTL_SECONDS=300

# Logging
LOG_LEVEL=INFO

# Data Collection Settings
COLLECTION_INTERVAL_MINUTES=30
MAX_TRAINS_TO_TRACK=10
